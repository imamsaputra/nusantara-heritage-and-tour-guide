  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Rumah Adat Batak Huta Bolon Simanindo merupakan \nsalah satu warisan budaya
    yang masih terjaga dengan\nbaik di Pulau Samosir. Bangunan ini menjadi simbol
    kehidupan\nmasyarakat Batak yang sarat akan nilai-nilai filosofis, sosial,\ndan
    spiritual. Dengan bentuk atap yang khas menyerupai tanduk\nkerbau, rumah adat
    ini menggambarkan kekuatan, perlindungan,\ndan keharmonisan."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
